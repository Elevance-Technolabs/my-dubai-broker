# Backend origin for better-auth — no trailing slash and NO /api.
# Production: https://mydubai-broker-backend.onrender.com
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001

# Backend API base — MUST end in /api. Without /api (or if unset on Vercel,
# which falls back to localhost) public pages silently show "No listings".
# Production: https://mydubai-broker-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# NEXT_PUBLIC_* values are baked in at build time — redeploy after changing
# them on Vercel.
