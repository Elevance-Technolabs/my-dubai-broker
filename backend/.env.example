# ── Server ──────────────────────────────────────────────────────────
PORT=3001
# Set to "production" on Render: enables SameSite=None; Secure cookies
# (frontend and backend are different sites) and hides internal error details.
NODE_ENV=development

# ── Database (PostgreSQL) ───────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ── Auth (read by better-auth itself) ───────────────────────────────
# Long random string, e.g. `openssl rand -base64 32`. Changing it signs
# everyone out.
BETTER_AUTH_SECRET=
# Public URL of THIS backend, no trailing slash and no /api.
# Local: http://localhost:3001 · Production: https://mydubai-broker-backend.onrender.com
BETTER_AUTH_URL=http://localhost:3001
# Google OAuth is currently disabled (commented out in src/lib/auth.ts /
# lib/auth-client.ts) — GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET aren't read
# anywhere right now. Add them back here if that's ever wired up again.

# ── Cloudflare R2 (uploads) ─────────────────────────────────────────
# The bucket's own CORS policy (Cloudflare dashboard → R2 → bucket →
# Settings → CORS Policy) must also allow every frontend origin with
# PUT/GET/HEAD, or browser uploads fail with a CORS error + 403.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Frontend / CORS ─────────────────────────────────────────────────
# Comma-separated list of every frontend origin allowed to call the API
# (also used as better-auth trustedOrigins). No trailing slashes.
# Production example: http://localhost:3000,https://mydubai-broker-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000
# Used in links inside emails (password reset, invitations).
FRONTEND_URL=http://localhost:3000

# ── Email ───────────────────────────────────────────────────────────
# Email is a placeholder today (src/lib/email.ts logs instead of sending).
EMAIL_FROM=My Dubai Broker <noreply@mydubaibroker.com>
EMAIL_VERIFICATION=false
