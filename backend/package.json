{
	"name": "mydubai-broker-backend",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx --env-file=.env --watch src/index.ts",
		"build": "prisma generate && rimraf dist && tsc",
		"start": "node --env-file=.env dist/src/index.js",
		"start:prod": "node dist/src/index.js",
		"format": "biome format --write .",
		"lint": "biome check .",
		"prepare": "lefthook install",
		"db:clean": "tsx --env-file=.env prisma/clean.ts",
		"db:reset": "npm run db:clean && npx prisma db seed"
	},
	"prisma": {
		"seed": "tsx --env-file=.env prisma/seed.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.32.1",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1136.0",
		"@aws-sdk/s3-request-presigner": "^3.1136.0",
		"@prisma/adapter-pg": "^7.0.0",
		"@prisma/client": "^7.1.0",
		"@types/cors": "^2.8.19",
		"@types/pg": "^8.15.6",
		"better-auth": "^1.3.34",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"express": "^5.1.0",
		"helmet": "^8.3.0",
		"meilisearch": "^0.54.0",
		"pg": "^8.16.3",
		"pino": "^10.1.0",
		"slug": "^11.0.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.3",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@types/express": "^5.0.5",
		"@types/node": "^24.10.0",
		"@types/slug": "^5.0.9",
		"lefthook": "^2.0.2",
		"prisma": "^7.1.0",
		"rimraf": "^6.1.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	}
}
